# --- Database ---------------------------------------------------------------
# Local Docker Compose database (see docker-compose.yml).
DATABASE_URL=postgresql://stride:stride@localhost:5432/stride
# Disposable database used by `pnpm test`. Its name must end in "_test"; tests wipe it.
TEST_DATABASE_URL=postgresql://stride:stride@localhost:5432/stride_test

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated browser origins allowed to call the API with credentials (CORS + CSRF check).
# The deployed origin serving the web build is always allowed for same-origin requests.
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (Railway/Render: 1). 0 = trust none.
TRUST_PROXY=0
LOG_LEVEL=info

# --- Authentication -----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=stride-api
JWT_AUDIENCE=stride-clients
# Session lifetime in hours; the JWT, the database session and the web cookie all share it.
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12
# Login/register attempts allowed per IP per window.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# --- Static web build -------------------------------------------------------------
# Serve the built web app (apps/web/dist) from this server. Enabled in production by default.
SERVE_WEB=false
