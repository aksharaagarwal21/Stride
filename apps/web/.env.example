# Leave empty to call the API on the same origin (/api). Vite proxies /api to API_PROXY_TARGET
# in development; in production Express serves this build, so no configuration is needed.
# VITE_ variables are embedded in the public JavaScript bundle — never put secrets here.
VITE_API_URL=
# Development proxy target (read by vite.config.ts only, not shipped to the browser).
API_PROXY_TARGET=http://localhost:4000
